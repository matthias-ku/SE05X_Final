      break;
    case kSE05x_RSASignatureAlgo_SHA256_PKCS1_PSS:
      hashLen = SHA256_LENGTH;
      SE05X.beginSHA256();
      SE05X.updateSHA256(&msg[i][0], MSG_LEN);
      SE05X.endSHA256(hash, &hashLen);
      Serial.print("Input SHA256 is:              ");
      printBufferHex(hash, hashLen);
      break;
    case kSE05x_RSASignatureAlgo_SHA384_PKCS1_PSS:
      hashLen = SHA384_LENGTH;
      SE05X.beginSHA384();
      SE05X.updateSHA384(&msg[i][0], MSG_LEN);
      SE05X.endSHA384(hash, &hashLen);
      Serial.print("Input SHA384 is:              ");
      printBufferHex(hash, hashLen);
      break;
    case kSE05x_RSASignatureAlgo_SHA512_PKCS1_PSS:
      hashLen = SHA512_LENGTH;
      SE05X.beginSHA512();
      SE05X.updateSHA512(&msg[i][0], MSG_LEN);
      SE05X.endSHA512(hash, &hashLen);
      Serial.print("Input SHA512 is:              ");
      printBufferHex(hash, hashLen);
      break;
    default:
      break;
    }
    
    emsaLen = S_LEN;
    SE05X.emsa_pss_encode(hash, hashLen, emsa, &emsaLen, sha_alg[i], kSE05x_RSABitLength_1024, &saltVal[i][0], SALT_LEN);

    Serial.print("emsa is:                     ");
    printBufferHex(emsa, emsaLen);

    // calculate the signature
    signatureLen = 0;
    SE05X.SignRSA(KeyId, emsa, emsaLen, signature, sizeof(signature), &signatureLen);

    // print the signature
    Serial.print("Signature using KeyId ");
    Serial.print(KeyId);
    Serial.print(" is: ");
    printBufferHex(signature, signatureLen);
    Serial.println();
    
    // To make the signature verifcation + the signature comparison fail, uncomment the next line:
    //signature[0] = 0x00;
    if(signatureLen == S_LEN){
      if(memcmp(&s[i][0],signature,signatureLen) == 0){
        Serial.println("Generated Signature matches test vector - passed");
        passedTests++;
      }else{
        Serial.println("Generated Signature does not match test vector - failed");
        Serial.print("Signature from test vector: ");
      printBufferHex(&s[i][0], S_LEN);
      }
    }else{
      Serial.println("Generated Signature does not match test vector - failed");
      Serial.print("Signature from test vector: ");
      printBufferHex(&s[i][0], S_LEN);
    }
    
    // To make the signature verifcation fail, uncomment the next line:
    //&s[i][0] = 0x00;

    // validate the signature
    if (SE05X.VerifyRSASSA_PSS(KeyId, hash, hashLen, &s[i][0], S_LEN)){
      Serial.println("test vector Verified");
      verifiedSignatures++;
    }
    else
    {
      Serial.println("failed to verify test vector");
    }
  }
  
  Serial.print("Tests Passed:");
  Serial.println(passedTests);
  Serial.print("Verifed Signatures:");
  Serial.println(verifiedSignatures);
  SE05X.deleteBinaryObject(KeyId);
}


